{
  "manifest_version": 3,
  "name": "Opportunity Cannon Application Helper",
  "version": "0.3.1",
  "description": "Fill verified answers on the active application page. Never submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabs",
    "alarms",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Opportunity Cannon"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
