{
  "name": "peopleping-opportunity-cannon",
  "version": "0.3.1",
  "private": true,
  "description": "Private opportunity research and human-reviewed application assistant",
  "author": "Opportunity Cannon contributors",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node native/privacy-check.cjs && node native/build-identity.cjs && vite build && esbuild electron/main.ts --bundle --platform=node --external:electron --external:node:sqlite --outfile=build/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=build/preload.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "node native/package.cjs"
  },
  "build": {
    "appId": "com.nukeitgames.opportunitycannon",
    "productName": "Opportunity Cannon",
    "directories": {
      "output": "release-0.3.1"
    },
    "files": [
      "build/main.cjs",
      "build/preload.cjs",
      "dist/**/*",
      "build/identity.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "branding/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "native/installer.nsh",
      "installerIcon": "branding/app.ico",
      "uninstallerIcon": "branding/app.ico",
      "installerHeaderIcon": "branding/app.ico",
      "shortcutName": "Opportunity Cannon"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "build/native",
        "to": "native",
        "filter": [
          "CannonHost.exe"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
